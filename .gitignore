# ============================================================
# DocuMind .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
ENV/
*.egg-info/
.installed.cfg
*.egg

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Node
node_modules/
frontend/node_modules/
dist/
frontend/dist/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Environment / secrets
.env
*.env
.env.*
backend/.env
backend/*.env
!.env.example
!backend/.env.example

# Large ML artifacts
ml/models/
ml/processed/
ml/.venv/

# Datasets
data/

# Runtime uploaded documents
backend/storage/uploads/
backend/storage/processed/
backend/storage/chroma/
backend/storage/chroma_test/

# Python vendored packages / local binaries
backend/packages/

# Large binary/data files
*.npy
*.npz
*.parquet
*.zip
*.tar
*.tar.gz
*.bin
*.pt
*.pth
*.safetensors
*.ckpt
*.sqlite
*.sqlite3

# Logs
*.log

# OS/editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Scratch and Temporary directories
scratch/
tmp/
temp/

# Evaluation Caches & Large Generated Artifacts
evaluation/**/__pycache__/
evaluation/**/.cache/
evaluation/results/*.tmp
evaluation/results/*.log

