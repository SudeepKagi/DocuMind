# ============================================================
# DocuMind .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.venv/
venv/
env/
ENV/
*.egg-info/
.installed.cfg
*.egg

# Secrets and Local Environment Configuration
.env
*.env
.env.*
!.env.example
backend/.env
backend/*.env
!backend/.env.example

# Jupyter Notebooks
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Node.js / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
dist/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Large ML Weights, Checkpoints & Processed Datasets (Retained Locally)
ml/models/
ml/processed/
ml/.venv/
data/

# Local Uploaded Document Storage & ChromaDB Runtime (Retained Locally)
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/processed/*
!backend/storage/processed/.gitkeep
backend/storage/chroma/*
!backend/storage/chroma/.gitkeep
backend/storage/chroma_test/

# Local Vendored Packages (Retained Locally for Standalone Windows Execution)
backend/packages/

# Data Formats & Database Binaries
*.npy
*.parquet
*.zip
*.tar
*.tar.gz
*.sqlite3
*.bin

# Logs & Temporary Files
*.log
scratch/
tmp/
temp/

# Operating System & Editor Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
