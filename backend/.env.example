# ============================================================
# DocuMind Backend Environment Configuration Template
# Copy this file to .env and configure your local settings:
#   cp .env.example .env
# ============================================================

# PostgreSQL Database Configuration
# Format: postgresql+psycopg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password@127.0.0.1:5432/documind

# ChromaDB Persistent Vector Storage
# Relative or absolute directory for user-uploaded document chunk index
CHROMA_PATH=./storage/chroma

# Development Tenant Context (MVP Default)
DEV_USER_ID=dev_user_001
DEV_USER_EMAIL=developer@documind.local

# API Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hosted Gemini Agent Settings
# Provide your Google Gemini API key here (never commit your actual key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

