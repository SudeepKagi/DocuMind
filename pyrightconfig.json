{
  "include": [
    "backend",
    "ml/src"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "ml/.venv",
    "backend/storage",
    "backend/packages"
  ],
  "extraPaths": [
    "backend",
    "backend/packages",
    "ml/src"
  ],
  "venvPath": "ml",
  "venv": ".venv",
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none"
}
